# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite — zero config, great for local dev
DATABASE_URL=sqlite:///./dev.db

# PostgreSQL — uncomment and fill in for production
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/urlshortener

# ---------------------------------------------------------------------------
# Redis  (optional — app degrades gracefully if Redis is unreachable)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

CELERY_TASK_ALWAYS_EAGER=true
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BASE_URL=http://localhost:8000

SHORT_CODE_LENGTH=6
MIN_ALIAS_LENGTH=3
MAX_ALIAS_LENGTH=32
CACHE_TTL_SECONDS=3600

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
